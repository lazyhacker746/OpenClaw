                  placeholder="The AI pitch will appear here..."
                />
              </div>
            </div>

            {/* Footer Actions */}
            <div className="p-5 sm:p-6 bg-[#111827] border-t border-gray-800 flex flex-col sm:flex-row justify-end gap-3 z-10">
              <button
                onClick={() => setIsInsightsOpen(false)}
