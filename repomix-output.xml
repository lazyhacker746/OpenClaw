            {filteredHistory.map((lead, idx) => (
              <div key={idx} className={`p-4 transition-colors ${selectedLeads.includes(lead["WhatsApp Link"]) ? 'bg-purple-50 dark:bg-purple-900/20' : 'bg-white dark:bg-black/20'} space-y-3`}>
